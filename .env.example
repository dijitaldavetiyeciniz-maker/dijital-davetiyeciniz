# ==============================================================================
# Dijital Davetiyeciniz - Production & Development Environment Template
# ==============================================================================

# Supabase Connectivity
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key

# Platform Security Secrets (Fail-Closed Enforcement)
SUPERADMIN_PASSWORD=your-strong-production-superadmin-password
SUPERADMIN_SESSION_SECRET=your-32-character-hmac-session-signing-secret
ADMIN_COOKIE_SECRET_V1=your-32-character-admin-cookie-hmac-secret

# Domain & Platform Configuration
NEXT_PUBLIC_SITE_URL=https://dijitaldavetiyeciniz.com
PLATFORM_ROOT_DOMAIN=dijitaldavetiyeciniz.com

# Payment Provider (Iyzico)
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_WEBHOOK_SECRET=your-iyzico-webhook-hmac-secret

# Transactional Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dijitaldavetiyeciniz@gmail.com
SMTP_PASS=your-app-specific-password

# Rate Limiting & Diagnostics (Optional)
PART5_TEST_MODE=false
